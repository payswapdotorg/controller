{
  "manifest_version": 3,
  "name": "Controller",
  "version": "1.1.0",
  "description": "Resident browser supervisor loop for governed GitHub work orders: monitor -> harvest -> review -> dispatch with a rotating intelligence chain (chat.z.ai, muse spark, Copilot bridge, any agent). No continue button.",
  "action": {
    "default_title": "Controller",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "src/service.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://github.com/*",
    "https://chat.z.ai/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chat.z.ai/*"
      ],
      "js": [
        "src/content/chatzai-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icons/icon-128.png"
  }
}
